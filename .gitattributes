# 文本文件统一 LF（Windows 检出时自动转 CRLF），避免行尾噪声。
* text=auto
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf

# 二进制文件禁止行尾转换。
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.exe binary
*.ttf binary
*.woff2 binary
*.cer binary
*.pfx binary
*.key binary
*.db binary
